<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HosBank | Connexion</title>
    <style>
      :root {
        --primary-dark: #0f172a;
        --primary-dark-2: #0a1128;
        --surface-light: #ffffff;
        --surface-soft: rgba(209, 214, 224, 0.42);
        --brand-accent: #0066ff;
        --brand-accent-2: #0284c7;
        --heading-light: #ffffff;
        --text-light: #cbd5e1;
        --muted-light: #94a3b8;
        --heading-dark: #0f172a;
        --text-dark: #64748b;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: Inter, "Segoe UI", sans-serif;
        background: var(--surface-soft);
        color: var(--heading-dark);
      }

      .screen {
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
      }

      .auth-shell {
        width: min(1440px, 100%);
        height: min(900px, 100vh);
        min-height: 680px;
        max-width: 100%;
        background: var(--primary-dark);
        display: flex;
        border-radius: 0;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(15, 23, 42, 0.18);
      }

      .hero {
        flex: 1.15;
        background: linear-gradient(180deg, var(--primary-dark) 0%, var(--primary-dark-2) 100%);
        padding: 56px 56px 32px 56px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 700;
        color: var(--heading-light);
        letter-spacing: 0.02em;
      }

      .brand-mark {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--brand-accent) 0%, var(--brand-accent-2) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 800;
      }

      .hero-copy {
        margin-top: 70px;
      }

      .hero h1 {
        margin: 0;
        font-size: 40px;
        line-height: 1.1;
        letter-spacing: -0.04em;
        color: var(--heading-light);
        font-weight: 800;
        max-width: 480px;
      }

      .hero p {
        margin-top: 18px;
        max-width: 430px;
        font-size: 16px;
        line-height: 1.6;
        color: var(--muted-light);
      }

      .hero-footer {
        color: var(--text-light);
        font-size: 12px;
        opacity: 0.85;
      }

      .form-panel {
        flex: 1;
        background: #edf3ff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
      }

      .login-card {
        width: 100%;
        max-width: 440px;
        background: var(--surface-light);
        border-radius: 16px;
        padding: 40px 36px 36px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }

      .login-card h2 {
        margin: 0;
        font-size: 26px;
        line-height: 1.3;
        color: var(--heading-dark);
        font-weight: 800;
      }

      .subtitle {
        margin: 10px 0 28px;
        font-size: 15px;
        color: var(--text-dark);
        line-height: 1.6;
      }

      .form-group {
        margin-bottom: 18px;
      }

      .form-group label {
        display: block;
        margin-bottom: 8px;
        color: var(--heading-dark);
        font-size: 14px;
        font-weight: 600;
      }

      .form-group input {
        width: 100%;
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
        color: var(--heading-dark);
        font: inherit;
      }

      .form-group input:focus {
        outline: 3px solid rgba(2, 132, 199, 0.16);
        border-color: var(--brand-accent-2);
      }

      .form-message {
        min-height: 22px;
        margin: 0 0 12px;
        color: #b42318;
        font-size: 14px;
        line-height: 1.5;
      }

      .form-message[data-state="success"] {
        color: #087f70;
      }

      .cta-btn {
        width: 100%;
        min-height: 48px;
        padding: 12px 18px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg, var(--brand-accent) 0%, var(--brand-accent-2) 100%);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(2, 132, 199, 0.2);
      }

      .cta-btn:disabled {
        cursor: wait;
        opacity: 0.72;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
        color: var(--brand-accent-2);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
      }

      .back-link span {
        font-size: 16px;
      }

      @media (max-width: 980px) {
        .auth-shell {
          height: auto;
          min-height: 100vh;
          flex-direction: column;
        }

        .hero {
          min-height: 260px;
          padding: 36px 28px 24px;
        }

        .hero-copy {
          margin-top: 26px;
        }

        .form-panel {
          min-height: 480px;
          padding: 32px 18px;
        }
      }

      @media (max-width: 520px) {
        .hero h1 {
          font-size: 34px;
        }

        .login-card {
          padding: 30px 22px;
        }
      }

    </style>
  </head>
  <body>
    <div class="screen">
      <div class="auth-shell">
        <aside class="hero">
          <div class="brand">
            <div class="brand-mark">H</div>
            <span>HosBank</span>
          </div>

          <div class="hero-copy">
            <h1>Protégez ce qui compte vraiment.</h1>
            <p>
              Une expérience bancaire moderne, sécurisée et pensée pour le confort de tous vos clients.
            </p>
          </div>

          <div class="hero-footer">© 2026 HosBank • Sécurité et confiance</div>
        </aside>

        <main class="form-panel">
          <section class="login-card" aria-labelledby="login-title">
            <h2 id="login-title">Connexion à votre espace</h2>
            <p class="subtitle">Accédez à votre espace HosBank en toute sécurité.</p>

            <form id="login-form">
              <div class="form-group">
                <label for="email">Adresse e-mail</label>
                <input id="email" name="email" type="email" autocomplete="username" required />
              </div>

              <div class="form-group">
                <label for="password">Mot de passe</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required />
              </div>

              <p class="form-message" id="login-message" role="status" aria-live="polite"></p>
              <button class="cta-btn" id="login-submit" type="submit">Se connecter</button>
            </form>

            <a href="#" class="back-link"><span aria-hidden="true">←</span> Retour</a>
          </section>
        </main>
      </div>
    </div>
    <script>
      const loginForm = document.querySelector('#login-form');
      const loginMessage = document.querySelector('#login-message');
      const loginSubmit = document.querySelector('#login-submit');

      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        loginMessage.textContent = '';
        loginMessage.dataset.state = '';
        loginSubmit.disabled = true;

        try {
          const response = await fetch('/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: loginForm.elements.email.value,
              password: loginForm.elements.password.value
            })
          });
          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || 'Connexion impossible.');
          }

          sessionStorage.setItem('hosbankToken', result.token);
          sessionStorage.setItem('hosbankUser', JSON.stringify(result.user));
          loginMessage.dataset.state = 'success';
          loginMessage.textContent = `Connexion réussie, ${result.user.firstName}.`;
          window.location.assign('/staff/dashboard');
        } catch (error) {
          loginMessage.textContent = error.message || 'Le serveur est indisponible.';
        } finally {
          loginSubmit.disabled = false;
        }
      });
    </script>
  </body>
</html>
