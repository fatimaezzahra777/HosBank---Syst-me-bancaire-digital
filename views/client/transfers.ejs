<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>HosBank - Virement</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body class="dashboard-page">


<header class="navbar">

    <div class="logo">

        <div class="logo-icon">
            H
        </div>

        HosBank

    </div>


    <nav class="navbar-links">

        <a href="/dashboard">
            Dashboard
        </a>

        <a href="/beneficiaries">
            Bénéficiaires
        </a>

        <a href="/transfers">
            Virement
        </a>

        <a href="/historique">
                Historique
            </a>

        <a href="/logout" class="logout">
            Déconnexion
        </a>

    </nav>

</header>



<main class="dashboard-container">


    <div class="dashboard-header">

        <h1>
            Effectuer un virement
        </h1>

        <p>
            Transférez de l'argent vers un bénéficiaire enregistré.
        </p>

    </div>



    <% if (error) { %>

        <div class="alert alert-error">
            <%= error %>
        </div>

    <% } %>



    <section class="table-card beneficiary-form-card">

        <h2>
            Nouveau virement
        </h2>


        <p class="section-description">
            Remplissez les informations du virement.
        </p>



        <form
            action="/transfers"
            method="POST"
        >


            <div class="form-group">

                <label for="account_id">
                    Compte à débiter
                </label>

                <select
                    id="account_id"
                    name="account_id"
                    required
                >

                    <option value="">
                        Sélectionner un compte
                    </option>


                    <% accounts.forEach(function(account) { %>

                        <option value="<%= account.id %>">

                            <%= account.type %>
                            -
                            <%= account.account_number %>
                            -
                            Solde :
                            <%= account.balance %> DH

                        </option>

                    <% }) %>

                </select>

            </div>



            <div class="form-group">

                <label for="beneficiary_id">
                    Bénéficiaire
                </label>

                <select
                    id="beneficiary_id"
                    name="beneficiary_id"
                    required
                >

                    <option value="">
                        Sélectionner un bénéficiaire
                    </option>


                    <% beneficiaries.forEach(function(beneficiary) { %>

                        <option
                            value="<%= beneficiary.id %>"
                        >

                            <%= beneficiary.name %>
                            -
                            <%= beneficiary.rib %>

                        </option>

                    <% }) %>

                </select>

            </div>



            <div class="form-group">

                <label for="amount">
                    Montant
                </label>

                <input
                    type="number"
                    id="amount"
                    name="amount"
                    min="0.01"
                    step="0.01"
                    placeholder="Ex : 500.00"
                    required
                >

            </div>



            <div class="form-group">

                <label for="description">
                    Motif
                </label>

                <textarea
                    id="description"
                    name="description"
                    placeholder="Ex : Paiement loyer"
                    rows="4"
                ></textarea>

            </div>



            <button
                type="submit"
                class="btn-primary"
            >
                Effectuer le virement
            </button>


        </form>

    </section>


</main>


</body>

</html>