<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>HosBank - Historique</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body class="dashboard-page">



    <nav class="navbar">

        <div class="logo">

            <div class="logo-icon">
                H
            </div>

            HosBank

        </div>


        <div class="navbar-links">

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/beneficiaries">
                Bénéficiaires
            </a>

            <a href="/transfers">
                Virements
            </a>

            <a href="/historique">
                Historique
            </a>

            <a
                href="/logout"
                class="logout"
            >
                Déconnexion
            </a>

        </div>

    </nav>


    <!-- =========================
         CONTENT
    ========================== -->

    <main class="dashboard-container">


        <div class="dashboard-header">

            <h1>
                Historique des opérations
            </h1>

            <p>
                Consultez l'ensemble de vos opérations bancaires.
            </p>

        </div>


        <!-- =========================
             HISTORY CARD
        ========================== -->

        <section class="history-card">


            <div class="history-header">

                <div>

                    <h2>
                        Mes opérations
                    </h2>

                    <p class="history-description">
                        Virements, dépôts, retraits et paiements.
                    </p>

                </div>

            </div>


            <!-- =========================
                 EMPTY
            ========================== -->

            <% if (!transactions || transactions.length === 0) { %>

                <div class="empty-state">

                    <div class="empty-icon">
                        €
                    </div>

                    <h3>
                        Aucune opération
                    </h3>

                    <p>
                        Votre historique est actuellement vide.
                    </p>

                </div>


            <% } else { %>


                <!-- =========================
                     TABLE
                ========================== -->

                <div class="history-table-container">

                    <table class="history-table">

                        <thead>

                            <tr>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Compte
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Montant
                                </th>

                                <th>
                                    Statut
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <% transactions.forEach(transaction => { %>

                                <tr>


                                    <td>
                                        <%= transaction.created_at %>
                                    </td>


                                    <td>
                                        <%= transaction.account_number || "-" %>
                                    </td>


                                    <td>
                                        <%= transaction.type %>
                                    </td>


                                    <td>
                                        <%= transaction.description || "-" %>
                                    </td>


                                    <td>

                                        <%= transaction.amount %> DH

                                    </td>


                                    <td>

                                        <span
                                            class="status-badge status-<%= transaction.status.toLowerCase() %>"
                                        >

                                            <%= transaction.status %>

                                        </span>

                                    </td>


                                </tr>

                            <% }) %>


                        </tbody>

                    </table>

                </div>


            <% } %>


        </section>


    </main>


</body>

</html>
